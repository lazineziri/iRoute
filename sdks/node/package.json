{
  "name": "@iroute/sdk",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "Thin Node.js client for the iRoute task-aware runtime",
  "homepage": "https://iroute.dev/docs/sdk/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazineziri/iRoute.git",
    "directory": "sdks/node"
  },
  "bugs": { "url": "https://github.com/lazineziri/iRoute/issues" },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=24.18.1" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "typescript": "7.0.2"
  }
}

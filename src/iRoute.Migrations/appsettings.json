{
  "Storage": {
    "Provider": "Sqlite",
    "AutoInitialize": false
  },
  "ConnectionStrings": {
    "iRoute": "Data Source=iroute.db"
  },
  "ModelGateway": {
    "Mode": "Deterministic"
  },
  "Observability": {
    "PayloadMode": "MetadataOnly"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}

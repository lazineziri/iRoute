{
  "Storage": {
    "Provider": "Sqlite",
    "AutoInitialize": true
  },
  "ConnectionStrings": {
    "iRoute": "Data Source=iroute.db"
  },
  "ModelGateway": {
    "Mode": "Deterministic",
    "GatewayId": "external",
    "Transport": "Buffered",
    "BaseUrl": null,
    "ApiKey": null,
    "ExecutePath": "v1/execute",
    "StreamPath": "v1/stream",
    "HealthPath": "health"
  },
  "Workflow": {
    "QueueCapacity": 16,
    "MaxParallelSteps": 4
  },
  "Lifecycle": {
    "DefaultArtifactTimeToLive": "30.00:00:00",
    "DefaultMemoryTimeToLive": "90.00:00:00"
  },
  "Observability": {
    "PayloadMode": "MetadataOnly",
    "MaxQueryDays": 90,
    "MaxExecutions": 1000,
    "MaxTimelineEvents": 1000,
    "MaxEventValueCharacters": 1000,
    "MaxRecentExecutions": 25
  },
  "Identity": {
    "Mode": "DevelopmentHeaders",
    "Authority": null,
    "Audience": null,
    "RequireHttpsMetadata": true,
    "TenantClaim": "tenant_id",
    "ActorClaim": "sub",
    "PermissionClaim": "scope"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

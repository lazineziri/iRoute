<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>iroute</AssemblyName>
    <RootNamespace>iRoute.Cli</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iroute</ToolCommandName>
    <PackageId>iRoute.Cli</PackageId>
    <Version>0.1.0-alpha.2</Version>
    <Description>Command-line client for the iRoute runtime.</Description>
    <PackageTags>ai;llm;router;cli;dotnet-tool</PackageTags>
    <PackageReleaseNotes>First alpha release of the iRoute command-line client.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../iRoute.Sdk.DotNet/iRoute.Sdk.DotNet.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

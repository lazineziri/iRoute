<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>iRoute.Sdk.DotNet</AssemblyName>
    <RootNamespace>iRoute.Sdk.DotNet</RootNamespace>
    <PackageId>iRoute.Sdk</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>Thin .NET client for the iRoute task-aware runtime.</Description>
    <PackageTags>ai;llm;router;sdk;task-aware</PackageTags>
    <PackageReleaseNotes>First alpha release of the v1 protocol client.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../iRoute.Contracts/iRoute.Contracts.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

{
  "Storage": {
    "Provider": "Sqlite",
    "AutoInitialize": true
  },
  "ConnectionStrings": {
    "iRoute": "Data Source=iroute.db"
  },
  "ModelGateway": {
    "Mode": "Deterministic",
    "BaseUrl": null,
    "ApiKey": null
  },
  "Workflow": {
    "QueueCapacity": 16,
    "MaxParallelSteps": 4
  },
  "Lifecycle": {
    "SweepInterval": "00:05:00",
    "DefaultArtifactTimeToLive": "30.00:00:00",
    "DefaultMemoryTimeToLive": "90.00:00:00",
    "ArchiveAfterInactive": "7.00:00:00",
    "DeleteAfterArchive": "7.00:00:00",
    "ArchiveRetention": "30.00:00:00",
    "MaxArtifactVersionsPerLineage": 5,
    "MaxMemoryVersionsPerLineage": 5,
    "MaxArtifactsPerTenant": 10000,
    "MaxMemoryRecordsPerTenant": 10000,
    "MaxArchivesPerTenant": 20000,
    "BatchSize": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}

{
  "Storage": {
    "Provider": "Sqlite",
    "AutoInitialize": true
  },
  "ConnectionStrings": {
    "iRoute": "Data Source=iroute.db"
  },
  "ModelGateway": {
    "Mode": "Deterministic",
    "BaseUrl": null,
    "ApiKey": null
  },
  "Workflow": {
    "QueueCapacity": 16,
    "MaxParallelSteps": 4
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}

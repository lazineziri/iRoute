{
  "Storage": {
    "Provider": "Sqlite",
    "AutoInitialize": true
  },
  "ConnectionStrings": {
    "iRoute": "Data Source=iroute.db"
  },
  "ModelGateway": {
    "Mode": "Deterministic",
    "GatewayId": "external",
    "Transport": "Buffered",
    "BaseUrl": null,
    "ApiKey": null,
    "ExecutePath": "v1/execute",
    "StreamPath": "v1/stream",
    "HealthPath": "health",
    "Deployments": [],
    "Resilience": {
      "Enabled": true,
      "MaximumAttempts": 3,
      "Circuit": {
        "FailureThreshold": 3,
        "OpenDuration": "00:00:30",
        "MaximumOpenDuration": "00:05:00",
        "ProbeLeaseDuration": "00:00:15"
      }
    }
  },
  "Workflow": {
    "QueueCapacity": 16,
    "MaxParallelSteps": 4,
    "RetryBaseDelayMilliseconds": 100,
    "RetryMaxDelayMilliseconds": 5000,
    "RetryJitterRatio": 0.2
  },
  "ExecutionWorker": {
    "Enabled": true,
    "WorkerId": null,
    "PollInterval": "00:00:00.250",
    "LeaseDuration": "00:00:30",
    "HeartbeatInterval": "00:00:05",
    "AbandonDelay": "00:00:01"
  },
  "Lifecycle": {
    "Enabled": true,
    "SweepInterval": "00:05:00",
    "DefaultArtifactTimeToLive": "30.00:00:00",
    "DefaultMemoryTimeToLive": "90.00:00:00",
    "ArchiveAfterInactive": "7.00:00:00",
    "DeleteAfterArchive": "7.00:00:00",
    "ArchiveRetention": "30.00:00:00",
    "MaxArtifactVersionsPerLineage": 5,
    "MaxMemoryVersionsPerLineage": 5,
    "MaxArtifactsPerTenant": 10000,
    "MaxMemoryRecordsPerTenant": 10000,
    "MaxArchivesPerTenant": 20000,
    "BatchSize": 500
  },
  "Observability": {
    "PayloadMode": "MetadataOnly",
    "MaxQueryDays": 90,
    "MaxExecutions": 1000,
    "MaxTimelineEvents": 1000,
    "MaxEventValueCharacters": 1000,
    "MaxRecentExecutions": 25
  },
  "Identity": {
    "Mode": "DevelopmentHeaders",
    "Authority": null,
    "Audience": null,
    "RequireHttpsMetadata": true,
    "TenantClaim": "tenant_id",
    "ActorClaim": "sub",
    "PermissionClaim": "scope"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

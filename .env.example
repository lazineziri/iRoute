# Local Compose defaults. Never commit real credentials.
IROUTE_DB_PASSWORD=replace-for-shared-environments
IROUTE_MODEL_GATEWAY_MODE=Deterministic
IROUTE_MODEL_GATEWAY_URL=
IROUTE_MODEL_GATEWAY_KEY=
IROUTE_MODEL_GATEWAY_ID=external
IROUTE_MODEL_GATEWAY_TRANSPORT=Buffered
IROUTE_GATEWAY_RESILIENCE_ENABLED=true
IROUTE_GATEWAY_MAXIMUM_ATTEMPTS=3
IROUTE_GATEWAY_FAILURE_THRESHOLD=3
IROUTE_GATEWAY_OPEN_DURATION=00:00:30
IROUTE_GATEWAY_MAXIMUM_OPEN_DURATION=00:05:00
IROUTE_GATEWAY_PROBE_LEASE_DURATION=00:00:15
IROUTE_WORKFLOW_QUEUE_CAPACITY=16
IROUTE_WORKFLOW_MAX_PARALLEL_STEPS=4

# Production-shaped Compose fails closed unless a JWT issuer and audience are configured.
IROUTE_IDENTITY_MODE=Jwt
IROUTE_IDENTITY_AUTHORITY=
IROUTE_IDENTITY_AUDIENCE=
IROUTE_IDENTITY_PERMISSION_CLAIM=scope

# Local Compose defaults. Never commit real credentials.
IROUTE_DB_PASSWORD=replace-for-shared-environments
IROUTE_MODEL_GATEWAY_URL=
IROUTE_MODEL_GATEWAY_KEY=
IROUTE_WORKFLOW_QUEUE_CAPACITY=16
IROUTE_WORKFLOW_MAX_PARALLEL_STEPS=4

# DevelopmentHeaders is suitable only for a local, trusted machine.
IROUTE_IDENTITY_MODE=DevelopmentHeaders
IROUTE_IDENTITY_AUTHORITY=
IROUTE_IDENTITY_AUDIENCE=

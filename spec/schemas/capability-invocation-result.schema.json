{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/capability-invocation-result.schema.json",
  "title": "CapabilityInvocationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["output", "usage", "confidence", "evidence", "metadata"],
  "properties": {
    "output": true,
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cost", "durationMilliseconds", "modelCalls", "toolCalls"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence-reference.schema.json" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "version",
        "connectorId",
        "kind",
        "trustLevel",
        "transport",
        "projected",
        "outputReference"
      ],
      "properties": {
        "capability": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "integer", "minimum": 1 },
        "connectorId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind": { "enum": ["Deterministic", "Model", "Tool", "Api", "Mcp", "Agent"] },
        "trustLevel": { "enum": ["Internal", "Registered", "ExternalUntrusted"] },
        "transport": { "type": "string", "minLength": 1, "maxLength": 100 },
        "projected": { "const": true },
        "outputReference": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

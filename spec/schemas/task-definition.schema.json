{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/task-definition.schema.json",
  "title": "TaskDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskType",
    "version",
    "description",
    "category",
    "inputSchema",
    "outputSchema",
    "requiredCapabilities",
    "allowedCapabilities",
    "contextSourcePolicy",
    "sideEffectClass",
    "permissionScopes",
    "approvalRequired",
    "qualityFloor",
    "budget",
    "validationStrategy",
    "escalationPolicy",
    "cachePolicy",
    "memoryPolicy",
    "retentionPolicy"
  ],
  "properties": {
    "taskType": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 120 },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "category": { "type": "string", "minLength": 1, "maxLength": 100 },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "allowedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "contextSourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedSources", "includeFullHistoryByDefault", "requireProvenance"],
      "properties": {
        "allowedSources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "includeFullHistoryByDefault": { "const": false },
        "requireProvenance": { "type": "boolean" }
      }
    },
    "sideEffectClass": {
      "enum": ["None", "ReadOnly", "ReversibleWrite", "IrreversibleWrite"]
    },
    "permissionScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "approvalRequired": { "type": "boolean" },
    "qualityFloor": { "type": "number", "minimum": 0, "maximum": 1 },
    "budget": { "$ref": "#/$defs/budget" },
    "validationStrategy": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "escalationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onValidationFailure", "onEvidenceConflict", "onLowConfidence"],
      "properties": {
        "onValidationFailure": { "enum": ["Fail", "Retry", "StrongerCapability", "HumanApproval"] },
        "onEvidenceConflict": { "enum": ["Fail", "Retry", "StrongerCapability", "HumanApproval"] },
        "onLowConfidence": { "enum": ["Fail", "Retry", "StrongerCapability", "HumanApproval"] }
      }
    },
    "cachePolicy": { "$ref": "#/$defs/lifecyclePolicy" },
    "memoryPolicy": { "$ref": "#/$defs/lifecyclePolicy" },
    "retentionPolicy": { "$ref": "#/$defs/lifecyclePolicy" }
  },
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputTokens",
        "maxOutputTokens",
        "maxModelCalls",
        "maxToolCalls",
        "maxParallelCalls",
        "maxTaskDepth",
        "maxCost",
        "deadlineMilliseconds",
        "retryCount"
      ],
      "properties": {
        "maxInputTokens": { "type": "integer", "minimum": 1 },
        "maxOutputTokens": { "type": "integer", "minimum": 1 },
        "maxModelCalls": { "type": "integer", "minimum": 0, "maximum": 16 },
        "maxToolCalls": { "type": "integer", "minimum": 0, "maximum": 64 },
        "maxParallelCalls": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxTaskDepth": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxCost": { "type": "number", "minimum": 0 },
        "deadlineMilliseconds": { "type": "integer", "minimum": 1, "maximum": 900000 },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "lifecyclePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ttlSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ttlSeconds": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}

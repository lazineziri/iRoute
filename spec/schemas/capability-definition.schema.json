{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/capability-definition.schema.json",
  "title": "CapabilityDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "version",
    "kind",
    "description",
    "inputSchema",
    "outputSchema",
    "sideEffectClass",
    "authenticationScopes",
    "permissionScopes",
    "idempotency",
    "retry",
    "serviceProfile",
    "cacheability",
    "freshnessSeconds",
    "dataSensitivity",
    "trustLevel",
    "isolation"
  ],
  "properties": {
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["Deterministic", "Model", "Tool", "Api", "Mcp", "Agent"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "inputSchema": { "type": "object" },
    "outputSchema": { "type": "object" },
    "sideEffectClass": {
      "enum": ["None", "ReadOnly", "ReversibleWrite", "IrreversibleWrite"]
    },
    "authenticationScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "permissionScopes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "requiredForWrites"],
      "properties": {
        "supported": { "type": "boolean" },
        "requiredForWrites": { "type": "boolean" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "retryableFailureClasses"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "retryableFailureClasses": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "serviceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedLatencyMilliseconds", "estimatedCost", "availability", "reliability"],
      "properties": {
        "expectedLatencyMilliseconds": { "type": "integer", "minimum": 0 },
        "estimatedCost": { "type": "number", "minimum": 0 },
        "availability": { "type": "number", "minimum": 0, "maximum": 1 },
        "reliability": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cacheability": { "enum": ["Never", "Scoped", "Public"] },
    "freshnessSeconds": { "type": ["integer", "null"], "minimum": 0 },
    "dataSensitivity": { "enum": ["Public", "Internal", "Confidential", "Restricted"] },
    "trustLevel": { "enum": ["Internal", "Registered", "ExternalUntrusted"] },
    "isolation": { "enum": ["InProcess", "Process", "Container", "Remote"] }
  }
}

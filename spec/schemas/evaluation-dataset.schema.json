{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/evaluation-dataset.schema.json",
  "title": "EvaluationDataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetId", "version", "recordedAt", "requiredCategories", "justifiedQualityGain", "policies", "tasks"],
  "$defs": {
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampleSize", "meanInputTokens", "meanOutputTokens", "meanCost", "meanLatencyMilliseconds", "p95LatencyMilliseconds", "meanModelCalls", "meanToolCalls"],
      "properties": {
        "sampleSize": { "type": "integer", "minimum": 1 },
        "meanInputTokens": { "type": "number", "minimum": 0 },
        "meanOutputTokens": { "type": "number", "minimum": 0 },
        "meanCost": { "type": "number", "minimum": 0 },
        "meanLatencyMilliseconds": { "type": "number", "minimum": 0 },
        "p95LatencyMilliseconds": { "type": "number", "minimum": 0 },
        "meanModelCalls": { "type": "number", "minimum": 0 },
        "meanToolCalls": { "type": "number", "minimum": 0 }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "value"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 300 },
        "operator": { "enum": ["equals", "contains", "notContains", "arrayContains"] },
        "value": true
      }
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "authorized", "executed"],
      "properties": {
        "attempted": { "type": "boolean" },
        "authorized": { "type": "boolean" },
        "executed": { "type": "boolean" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "completed", "terminalStatus", "output", "evidence", "claimCount", "unsupportedClaims", "sideEffect", "resolutionLevel", "selectedProfileId"],
      "properties": {
        "policyId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$", "maxLength": 200 },
        "completed": { "type": "boolean" },
        "terminalStatus": { "enum": ["Succeeded", "Failed", "Cancelled", "TimedOut"] },
        "errorCode": { "type": ["string", "null"], "maxLength": 120 },
        "output": true,
        "evidence": { "type": "array", "items": { "$ref": "evidence-reference.schema.json" } },
        "claimCount": { "type": "integer", "minimum": 0 },
        "unsupportedClaims": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "sideEffect": { "$ref": "#/$defs/sideEffect" },
        "resolutionLevel": {
          "enum": ["ExactArtifact", "StructuredState", "SemanticMemory", "DeterministicCapability", "SmallModel", "StrongModel", "VerifiedOrHuman"]
        },
        "selectedProfileId": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminalStatus", "assertions", "requiredEvidenceReferences", "minimumEvidencePrecision", "minimumEvidenceCoverage", "maximumUnsupportedClaims", "sideEffectExecution", "authorizationRequired"],
      "properties": {
        "terminalStatus": { "enum": ["Succeeded", "Failed", "Cancelled", "TimedOut"] },
        "errorCode": { "type": ["string", "null"], "maxLength": 120 },
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" } },
        "requiredEvidenceReferences": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "minimumEvidencePrecision": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimumEvidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "maximumUnsupportedClaims": { "type": "integer", "minimum": 0 },
        "sideEffectExecution": { "enum": ["forbidden", "required", "optional"] },
        "authorizationRequired": { "type": "boolean" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "category", "request", "expected", "observations"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$", "maxLength": 200 },
        "category": { "enum": ["normal", "edge", "adversarial", "stale-memory", "unauthorized-action", "dependency-change"] },
        "request": { "$ref": "task-request.schema.json" },
        "expected": { "$ref": "#/$defs/expected" },
        "observations": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/observation" } }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskType", "evaluatorId", "qualityFloor", "cases"],
      "properties": {
        "taskType": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$", "maxLength": 120 },
        "evaluatorId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$", "maxLength": 160 },
        "qualityFloor": { "type": "number", "minimum": 0, "maximum": 1 },
        "cases": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/case" } }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "role", "description", "sourceFingerprint", "sourceFiles", "benchmarks"],
      "properties": {
        "policyId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$", "maxLength": 200 },
        "role": { "enum": ["baseline", "candidate"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sourceFingerprint": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sourceFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "benchmarks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/benchmark" }
        }
      }
    }
  },
  "properties": {
    "datasetId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$", "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "requiredCategories": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["normal", "edge", "adversarial", "stale-memory", "unauthorized-action", "dependency-change"] }
    },
    "justifiedQualityGain": { "type": "number", "minimum": 0, "maximum": 1 },
    "policies": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/policy" } },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
  }
}

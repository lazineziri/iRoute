{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/execution-plan.schema.json",
  "title": "ExecutionPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "version", "taskType", "taskVersion", "steps", "budget"],
  "properties": {
    "planId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "integer", "minimum": 1 },
    "taskType": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 120 },
    "taskVersion": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/step" }
    },
    "budget": { "$ref": "#/$defs/budget" }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "capability",
        "dependsOn",
        "sideEffectClass",
        "timeoutMilliseconds",
        "maxAttempts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "kind": { "enum": ["Deterministic", "Model", "Tool", "Approval"] },
        "capability": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" }
        },
        "sideEffectClass": {
          "enum": ["None", "ReadOnly", "ReversibleWrite", "IrreversibleWrite"]
        },
        "timeoutMilliseconds": { "type": "integer", "minimum": 100, "maximum": 900000 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "profileId": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxSteps",
        "maxModelCalls",
        "maxToolCalls",
        "maxParallelCalls",
        "maxTaskDepth",
        "deadlineMilliseconds"
      ],
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxModelCalls": { "type": "integer", "minimum": 0, "maximum": 16 },
        "maxToolCalls": { "type": "integer", "minimum": 0, "maximum": 64 },
        "maxParallelCalls": { "type": "integer", "minimum": 1, "maximum": 32 },
        "maxTaskDepth": { "type": "integer", "minimum": 1, "maximum": 16 },
        "deadlineMilliseconds": { "type": "integer", "minimum": 1, "maximum": 900000 },
        "maxInputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "maxOutputTokens": { "type": ["integer", "null"], "minimum": 1 },
        "maxCost": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}

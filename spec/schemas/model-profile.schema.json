{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/model-profile.schema.json",
  "title": "ModelProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "capability",
    "tier",
    "supportedTaskTypes",
    "expectedQuality",
    "estimatedCost",
    "expectedLatencyMilliseconds",
    "uncertainty",
    "reliability",
    "availability",
    "maxInputTokens",
    "maxOutputTokens",
    "healthy",
    "measurementSource"
  ],
  "properties": {
    "profileId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 200 },
    "tier": { "enum": ["Small", "Strong", "Verifier"] },
    "supportedTaskTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$", "maxLength": 120 }
    },
    "expectedQuality": { "type": "number", "minimum": 0, "maximum": 1 },
    "estimatedCost": { "type": "number", "minimum": 0 },
    "expectedLatencyMilliseconds": { "type": "integer", "minimum": 0 },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 1 },
    "reliability": { "type": "number", "minimum": 0, "maximum": 1 },
    "availability": { "type": "number", "minimum": 0, "maximum": 1 },
    "maxInputTokens": { "type": "integer", "minimum": 1 },
    "maxOutputTokens": { "type": "integer", "minimum": 1 },
    "healthy": { "type": "boolean" },
    "measurementSource": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}

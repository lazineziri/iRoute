{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/capability-failure.schema.json",
  "title": "CapabilityFailure",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "kind", "message", "retryable"],
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 100 },
    "kind": {
      "enum": ["InvalidRequest", "PermissionDenied", "NotRegistered", "Timeout", "Unavailable", "InvalidResponse", "OutputLimitExceeded", "Cancelled", "Internal"]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "retryable": { "type": "boolean" },
    "capability": { "type": ["string", "null"], "maxLength": 200 },
    "connectorId": { "type": ["string", "null"], "maxLength": 200 },
    "correlationId": { "type": ["string", "null"], "maxLength": 200 }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iroute.dev/v1/model-gateway-result.schema.json",
  "title": "ModelGatewayResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["output", "usage", "confidence", "evidence"],
  "properties": {
    "output": true,
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputTokens", "outputTokens", "cost", "durationMilliseconds", "modelCalls", "toolCalls"],
      "properties": {
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "cost": { "type": "number", "minimum": 0 },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "modelCalls": { "type": "integer", "minimum": 0 },
        "toolCalls": { "type": "integer", "minimum": 0 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": {
      "type": "array",
      "items": { "$ref": "evidence-reference.schema.json" }
    },
    "gatewayId": { "type": ["string", "null"], "maxLength": 200 },
    "transport": { "enum": ["Buffered", "Streaming"] },
    "finishReason": { "enum": ["Completed", "Length", "ContentFiltered", "ToolCall", "Other"] },
    "deployment": {
      "oneOf": [
        { "$ref": "gateway-deployment-reference.schema.json" },
        { "type": "null" }
      ]
    },
    "resilience": {
      "oneOf": [
        { "$ref": "gateway-resilience-trace.schema.json" },
        { "type": "null" }
      ]
    }
  }
}
